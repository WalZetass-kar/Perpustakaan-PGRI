##############################################################
#  KONFIGURASI LOKAL (LAN)
#  Untuk setup satu komputer sebagai server di jaringan sekolah
#  menggunakan XAMPP (Windows) atau LAMPP (Linux).
#
#  CARA PAKAI:
#  1. Salin file ini, ubah nama menjadi: .env
#  2. Isi IP_SERVER di APP_URL dengan IP komputer server
#     (cek dengan: ipconfig [Windows] / ip addr [Linux])
#  3. Jalankan: php artisan key:generate
#  4. Jalankan: php artisan migrate --seed --force
##############################################################

APP_NAME="Sistem Informasi Perpustakaan"
APP_ENV=production

# WAJIB: Isi setelah menjalankan: php artisan key:generate
APP_KEY=

APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta

# WAJIB: Ganti 192.168.1.10 dengan IP komputer server Anda
# Cara cek IP di Windows: buka CMD → ketik ipconfig → cari "IPv4 Address"
# Cara cek IP di Linux : buka Terminal → ketik ip addr → cari inet di eth0/wlan0
APP_URL=http://192.168.1.10

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Jalur kustom halaman login admin
ADMIN_LOGIN_PATH=akses-perpustakaan

# Password admin awal saat seeding (kosongkan = sistem buat password acak, cek output terminal)
SEED_ADMIN_PASSWORD=

# -------------------------------------------------------
# DATABASE — XAMPP / LAMPP default
# Jika XAMPP/LAMPP sudah ubah password root MySQL, sesuaikan DB_PASSWORD
# -------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=perpustakaan
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=cookie
SESSION_LIFETIME=240
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
CACHE_STORE=file

# Kosongkan — tidak ada reverse proxy di jaringan lokal
TRUSTED_PROXIES=
