##############################################################
#  KONFIGURASI LOKAL (LAN)
#  Untuk satu komputer sekolah yang dijadikan server jaringan.
#
#  INILAH berkas yang harus dipakai untuk pemasangan lokal —
#  bukan .env.example, yang ditujukan untuk hosting internet.
#
#  CARA PAKAI:
#  1. Salin berkas ini, ubah namanya menjadi: .env
#  2. Isi APP_URL dengan IP komputer server
#     (cek dengan: ipconfig [Windows] / hostname -I [Linux])
#  3. Jalankan: php artisan key:generate
#  4. Jalankan: php artisan migrate --seed
#  5. Jalankan: php artisan storage:link
#
#  Panduan lengkapnya ada di folder PANDUAN_SERVER_LOKAL/
##############################################################
APP_NAME="Sistem Informasi Perpustakaan"
# JANGAN diubah menjadi `production` untuk server lokal.
#
# Pada `production`, aplikasi memaksa seluruh alamat menjadi https://
# (lihat app/Providers/AppServiceProvider.php). Server lokal hanya melayani
# http biasa, sehingga akibatnya: seluruh CSS dan JavaScript gagal dimuat,
# halaman tampil polos tanpa gaya, dan menunya tidak bisa diklik — tanpa satu
# pun pesan galat yang menjelaskan penyebabnya.
#
# Nilai `local` di sini TIDAK membuat galat teknis terlihat oleh siswa. Yang
# mengatur hal itu APP_DEBUG di bawah, dan nilainya tetap false.
APP_ENV=local

# WAJIB: Isi setelah menjalankan: php artisan key:generate
APP_KEY=

APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta

# WAJIB: Ganti 192.168.1.10 dengan IP komputer server Anda, dan sertakan
# nomor portnya (:8000) persis seperti alamat yang diketik di browser.
# Bila nanti server dijalankan pada port 80, tulis tanpa :8000
# Cara cek IP di Windows: buka CMD → ketik ipconfig → cari "IPv4 Address"
# Cara cek IP di Linux : buka Terminal → ketik ip addr → cari inet di eth0/wlan0
APP_URL=http://192.168.1.10:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Jalur kustom halaman login admin
ADMIN_LOGIN_PATH=akses-perpustakaan

# Password untuk akun bawaan admin@sekolah.sch.id dan pustakawan@sekolah.sch.id.
#
# WAJIB DIISI sebelum menjalankan `php artisan migrate --seed`. Bila dibiarkan
# kosong, sistem membuat password acak yang TIDAK ditampilkan di mana pun,
# sehingga kedua akun itu tidak bisa dipakai. (Masih dapat diperbaiki dengan
# `php artisan perpus:reset-password`, tapi lebih repot.)
SEED_ADMIN_PASSWORD=

# -------------------------------------------------------
# DATABASE — XAMPP / LAMPP default
# Jika XAMPP/LAMPP sudah ubah password root MySQL, sesuaikan DB_PASSWORD
# -------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=perpustakaan
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=cookie
SESSION_LIFETIME=240
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
CACHE_STORE=file

# Kosongkan — tidak ada reverse proxy di jaringan lokal
TRUSTED_PROXIES=
