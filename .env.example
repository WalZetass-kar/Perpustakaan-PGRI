APP_NAME="Sistem Informasi Perpustakaan"
APP_ENV=production
# WAJIB: Jalankan `php artisan key:generate` setelah menyalin berkas ini
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Jalur kustom halaman login admin (opsional, default: akses-perpustakaan)
ADMIN_LOGIN_PATH=akses-perpustakaan

# Password admin awal saat seeding (opsional, jika kosong sistem akan menghasilkan password acak aman)
SEED_ADMIN_PASSWORD=

# WAJIB: Konfigurasi basis data MySQL / MariaDB server
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=perpustakaan
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
CACHE_STORE=array

# IP Proxy / Load Balancer jika berada di balik reverse proxy (pisahkan dengan koma)
TRUSTED_PROXIES=
