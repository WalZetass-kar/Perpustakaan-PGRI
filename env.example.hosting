##############################################################
#  KONFIGURASI HOSTING / VPS / CLOUD
#  Untuk deploy ke shared hosting (cPanel), VPS Linux, atau
#  layanan cloud seperti Railway.
#
#  CARA PAKAI:
#  1. Salin file ini, ubah nama menjadi: .env
#  2. Isi semua nilai yang ditandai WAJIB
#  3. Jalankan: php artisan key:generate
#  4. Jalankan: php artisan migrate --seed --force
##############################################################

APP_NAME="Sistem Informasi Perpustakaan"
APP_ENV=production

# WAJIB: Isi setelah menjalankan: php artisan key:generate
APP_KEY=

APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta

# WAJIB: Ganti dengan URL domain/subdomain Anda (sertakan https:// jika pakai SSL)
# Contoh: https://perpustakaan.smkpgri.sch.id
APP_URL=https://domain-sekolah-anda.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Jalur kustom halaman login admin
ADMIN_LOGIN_PATH=akses-perpustakaan

# Password admin awal saat seeding (kosongkan = sistem buat password acak, cek output terminal)
SEED_ADMIN_PASSWORD=

# -------------------------------------------------------
# DATABASE — Shared Hosting / VPS
# Ambil nilai-nilai ini dari panel cPanel / phpMyAdmin / VPS Anda
# -------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306

# WAJIB: Nama database yang dibuat di cPanel/VPS
DB_DATABASE=nama_database_anda

# WAJIB: Username dan password database
DB_USERNAME=user_database_anda
DB_PASSWORD=password_database_anda

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
CACHE_STORE=array

# Isi dengan * HANYA jika hosting Anda benar-benar berada di belakang load
# balancer / reverse proxy (Railway, Cloudflare, dll.).
#
# Kalau diisi * padahal tidak ada proxy, Laravel akan mempercayai header
# X-Forwarded-For yang dikirim pengunjung, sehingga pembatas percobaan login
# (5 kali per menit) bisa dilewati hanya dengan mengganti header itu.
# Biarkan kosong jika tidak yakin.
TRUSTED_PROXIES=
